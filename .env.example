LASTFM_API_KEY=your_api_key_here
LASTFM_USERNAME=your_username_here

# Required by MusicBrainz policy — an email or URL identifying this
# client. See https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_CONTACT=your_email_here

# Optional — used only for narrative text enrichment.
# GENIUS_ACCESS_TOKEN=your_token_here

# Optional — number of top tracks to enrich per run (default 50).
# ENRICH_TOP_N=50
